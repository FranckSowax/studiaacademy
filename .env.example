# Studia Academy — variables d'environnement (copier en .env.local, ne jamais committer les valeurs)

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # serveur uniquement

# === IA ===
MISTRAL_API_KEY=

# === WhatsApp via WAHA (auto-hébergé, remplace Whapi) ===
WAHA_BASE_URL=http://localhost:3001  # prod : URL privée Railway, ex. http://waha.railway.internal:3000
WAHA_API_KEY=                         # = WAHA_API_KEY du conteneur WAHA
WAHA_SESSION=default                  # WAHA Core : une seule session "default"
WAHA_WEBHOOK_HMAC_KEY=                # = WHATSAPP_HOOK_HMAC_KEY du conteneur WAHA
STUDIA_TEAM_PHONE=                    # numéro de l'équipe pour les notifications internes (ex. 24177000000)

# === Messagerie : qualification IA et tâches planifiées ===
OPENROUTER_API_KEY=                   # active OpenRouter (coût exact renvoyé par l'API)
INBOX_ANALYSIS_MODEL=                 # identifiant OpenRouter « fournisseur/modele » (obligatoire avec OpenRouter)
INBOX_ANALYSIS_PROVIDER=              # facultatif : openrouter | mistral
INBOX_ANALYSIS_MAX_TOKENS=3000        # les modèles qui « raisonnent » ont besoin de marge
INBOX_ANALYSIS_DAILY_CAP=200          # analyses max par jour
INBOX_ANALYSIS_BATCH=10               # analyses max par passage planifié
INBOX_CRON_SECRET=                    # ≥ 16 caractères ; en-tête Authorization: Bearer … des tâches planifiées

# === Conteneur WAHA uniquement (docker-compose.waha.yml) ===
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_DEFAULT_ENGINE=WEBJS

# === Site ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=          # numéro affiché sur le site (lien wa.me)
NEXT_PUBLIC_AIRTEL_MONEY=
NEXT_PUBLIC_MOOV_MONEY=
